                            {"key": "Authorization", "value": "Bearer {{auth_token}}"}
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/jobs/1/analytics",
                            "host": ["{{base_url}}"],
                            "path": ["api", "jobs", "1", "analytics"]
                        }
                    }
                },
                {
                    "name": "Apply To Job (Employee)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{auth_token}}"}
