{
    "info": {
        "_postman_id": "e0e24185-3031-419f-b7a4-8461db1d0ab9",
        "name": "JobFindLink V2 API",
        "description": "Comprehensive API collection for the JobFindLink hiring platform (Employee & Employer Workflows)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Authentication",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {"key": "full_name", "value": "John Doe", "type": "text"},
                                {"key": "mobile", "value": "9876543210", "type": "text"},
                                {"key": "email", "value": "john@example.com", "type": "text"},
                                {"key": "password", "value": "password123", "type": "text"},
                                {"key": "password_confirmation", "value": "password123", "type": "text"},
                                {"key": "role", "value": "employee", "description": "employee / employer", "type": "text"},
                                {"key": "age", "value": "26", "type": "text"},
                                {"key": "gender", "value": "male", "type": "text"},
                                {"key": "seeking_position", "value": "PHP Developer", "type": "text"},
                                {"key": "experience_type", "value": "experienced", "type": "text"}
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/auth/register",
                            "host": ["{{base_url}}"],
                            "path": ["api", "auth", "register"]
                        }
                    }
                },
                {
                    "name": "Send OTP",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {"key": "mobile", "value": "9876543210", "type": "text"},
                                {"key": "purpose", "value": "login", "type": "text"}
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/auth/send-otp",
                            "host": ["{{base_url}}"],
                            "path": ["api", "auth", "send-otp"]
                        }
                    }
                },
                {
                    "name": "Verify OTP",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {"key": "mobile", "value": "9876543210", "type": "text"},
                                {"key": "otp_code", "value": "123456", "type": "text"}
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/auth/verify-otp",
                            "host": ["{{base_url}}"],
                            "path": ["api", "auth", "verify-otp"]
                        }
                    }
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {"key": "mobile", "value": "9876543210", "type": "text"},
                                {"key": "otp_code", "value": "123456", "description": "Pass OTP code or password", "type": "text"}
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/auth/login",
                            "host": ["{{base_url}}"],
                            "path": ["api", "auth", "login"]
                        }
                    }
                }
            ]
        },
