        {
            "name": "3. Employee Dashboard",
            "item": [
                {
                    "name": "Get Dashboard Details",
                    "request": {
                        "method": "GET",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{auth_token}}"}
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/employee/dashboard",
                            "host": ["{{base_url}}"],
                            "path": ["api", "employee", "dashboard"]
                        }
                    }
                },
                {
                    "name": "Update Profile",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{auth_token}}"}
                        ],
                        "body": {
                            "mode": "urlencoded",
                            "urlencoded": [
                                {"key": "experience_type", "value": "experienced", "type": "text"},
                                {"key": "job_position", "value": "PHP Developer", "type": "text"},
                                {"key": "expected_salary", "value": "60000", "type": "text"},
                                {"key": "preferred_locations[0]", "value": "Mumbai", "type": "text"},
                                {"key": "skills[0]", "value": "Laravel", "type": "text"}
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/employee/profile",
                            "host": ["{{base_url}}"],
                            "path": ["api", "employee", "profile"]
                        }
                    }
                },
                {
                    "name": "Upload Resume",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{auth_token}}"}
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {"key": "resume", "type": "file", "src": []}
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/employee/upload-resume",
                            "host": ["{{base_url}}"],
                            "path": ["api", "employee", "upload-resume"]
                        }
                    }
                },
                {
                    "name": "Build Resume",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{auth_token}}"}
                        ],
                        "body": {
                            "mode": "urlencoded",
                            "urlencoded": [
                                {"key": "template", "value": "classic", "type": "text"},
                                {"key": "summary", "value": "Experienced developer...", "type": "text"}
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/employee/build-resume",
                            "host": ["{{base_url}}"],
                            "path": ["api", "employee", "build-resume"]
                        }
                    }
                },
                {
                    "name": "Verify ID (Aadhaar/PAN)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{auth_token}}"}
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {"key": "aadhaar_number", "value": "123412341234", "type": "text"},
                                {"key": "id_document_front", "type": "file", "src": []}
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/employee/verify-id",
                            "host": ["{{base_url}}"],
                            "path": ["api", "employee", "verify-id"]
                        }
                    }
                }
            ]
