        {
            "name": "5. Job Postings",
            "item": [
                {
                    "name": "Search Jobs",
                    "request": {
                        "method": "GET",
                        "header": [
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/jobs/search?q=developer&work_location_type=wfh",
                            "host": ["{{base_url}}"],
                            "path": ["api", "jobs", "search"],
                            "query": [
                                {"key": "q", "value": "developer"},
                                {"key": "work_location_type", "value": "wfh"}
                            ]
                        }
                    }
                },
                {
                    "name": "Post Job (Employer)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{auth_token}}"}
                        ],
                        "body": {
                            "mode": "urlencoded",
                            "urlencoded": [
                                {"key": "title", "value": "Senior PHP Developer", "type": "text"},
                                {"key": "job_type", "value": "full-time", "type": "text"},
                                {"key": "location", "value": "Mumbai", "type": "text"},
                                {"key": "work_location_type", "value": "hybrid", "type": "text"},
                                {"key": "pay_type", "value": "range", "type": "text"},
                                {"key": "salary_min", "value": "50000", "type": "text"},
                                {"key": "salary_max", "value": "90000", "type": "text"},
                                {"key": "description", "value": "We need an advanced developer.", "type": "text"},
                                {"key": "is_draft", "value": "0", "type": "text"}
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/api/jobs",
                            "host": ["{{base_url}}"],
                            "path": ["api", "jobs"]
                        }
                    }
                },
                {
                    "name": "Job Analytics (Employer)",
                    "request": {
                        "method": "GET",
                        "header": [
